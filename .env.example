# Admin
ADMIN_ID=...

# Bot
TOKEN=...
BOT_ID=...

# Account
HOST_ID=...
API_ID=...
API_HASH=...

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional: yt-dlp cookies file (Netscape format), relative to project root.
# Needed when YouTube blocks the server IP with "Sign in to confirm you're
# not a bot" (common on VPS). Leave unset to run without cookies.
# COOKIES_FILE=data/cookies.txt

# Docker Compose profiles this host runs. The bot and userbot can be split
# across hosts: `vps` = redis + bot, `home` = userbot + pot-provider.
# Set one per host; use both (comma-separated) to run everything on one host.
COMPOSE_PROFILES=vps,home
